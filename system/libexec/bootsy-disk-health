#!/usr/bin/bash
set -u

threshold="${BOOTSY_DISK_WARN_PERCENT:-85}"
status=0
while read -r filesystem used mountpoint; do
    percent="${used%%%}"
    if (( percent >= threshold )); then
        logger -p daemon.warning -t bootsy-disk-health \
            "$mountpoint is ${used} full on $filesystem (threshold ${threshold}%)"
        status=1
    fi
done < <(df -P -x tmpfs -x devtmpfs | awk 'NR > 1 {print $1, $5, $6}')

if command -v nvme >/dev/null 2>&1; then
    for controller in /dev/nvme[0-9]; do
        [[ -e "$controller" ]] || continue
        nvme smart-log "$controller" >/dev/null || status=1
    done
fi

if command -v smartctl >/dev/null 2>&1; then
    while read -r device _; do
        [[ -n "$device" ]] || continue
        smartctl -H "$device" >/dev/null || status=1
    done < <(smartctl --scan-open 2>/dev/null || true)
fi

exit "$status"
