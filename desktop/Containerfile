ARG BASE_IMAGE=ghcr.io/eelcoh/bootsy-linux/base:latest
FROM ${BASE_IMAGE}

ARG BOOTSY_VERSION=development
ARG VCS_REF=unknown

RUN printf 'FLAVOR=desktop\nVERSION=%s\nVCS_REF=%s\n' "$BOOTSY_VERSION" "$VCS_REF" \
        > /usr/lib/bootsy-release

# bootsy-desktop: Niri+DankMaterialShell, Sway, and COSMIC installed
# side by side, switchable at the graphical login screen rather
# than three separate images the way kubevirt-host-bootc-image did it.
# Plus a bluefin-dx-inspired developer
# experience layer (Homebrew, Docker, VS Code, mise, Ptyxis, Flatpak).

# ============================== Desktops ==============================
#
# All three DEs' packages plus their shared portal/audio/font stack, in one
# transaction. Package names/versions confirmed directly against Fedora 44
# repos (`dnf5 repoquery`) while building this image, no COPRs.
#
# - niri + DankMaterialShell: scrollable-tiling
#   compositor + DMS's Quickshell-based bar/launcher/lock/notifications).
# - sway + sway-config-fedora + waybar + swaylock/swayidle: i3-compatible
#   wlroots compositor with Fedora's own stock config.
# - cosmic-desktop (comps group, pulls in the compositor/panel/apps) +
#   xdg-desktop-portal-cosmic: System76's COSMIC. cosmic-greeter isn't in
#   the group's own mandatory/default package list, but cosmic-session
#   (which is) hard-Requires it as of Fedora 44's packaging (confirmed:
#   `dnf5 repoquery --whatrequires cosmic-greeter` lists every cosmic-session
#   build), so it ends up installed regardless of not being asked for. Bootsy
#   disables its display-manager unit in favor of graphical gtkgreet.
# - alacritty: terminal for niri (matches its default Mod+T keybind) and
#   sway; COSMIC uses its own cosmic-term from the group.
# - Zen Browser: installed system-wide from its officially recommended Flathub
#   distribution later in this file, after Flatpak is configured.
# - bluez: explicit Bluetooth stack rather than relying on incidental desktop
#   group dependencies; DMS and COSMIC provide the pairing UI.
# - xdg-desktop-portal(-gtk/-gnome/-wlr/-cosmic), gnome-keyring, polkit-kde,
#   pipewire stack, Noto fonts: shared plumbing every session needs.
RUN dnf -y install \
    niri \
    DankMaterialShell \
    sway \
    sway-config-fedora \
    waybar \
    swaylock \
    swayidle \
    greetd \
    gtkgreet \
    xdg-desktop-portal-cosmic \
    alacritty \
    bluez \
    xdg-desktop-portal \
    xdg-desktop-portal-gtk \
    xdg-desktop-portal-gnome \
    xdg-desktop-portal-wlr \
    gnome-keyring \
    polkit-kde \
    pipewire \
    pipewire-pulseaudio \
    pipewire-alsa \
    wireplumber \
    google-noto-sans-fonts \
    google-noto-emoji-fonts \
    swaybg \
    fedora-workstation-backgrounds \
    fwupd \
    bolt \
    iio-sensor-proxy \
    power-profiles-daemon \
    switcheroo-control \
    fprintd \
    cups \
    cups-pk-helper \
    system-config-printer \
    sane-airscan \
    libsane-airscan \
    simple-scan \
    ipp-usb \
    avahi \
    file-roller \
    loupe \
    evince \
    gnome-text-editor \
    nautilus \
    && dnf -y group install cosmic-desktop \
    && dnf clean all \
    && sed -i 's/^#AutoEnable=true$/AutoEnable=true/' /etc/bluetooth/main.conf \
    && systemctl enable bluetooth.service cups.service avahi-daemon.service

COPY desktop/docs/ /usr/share/doc/bootsy/desktop/

# Original Bootsy wallpaper collection, shared by Niri/DMS, Sway/DMS, and
# COSMIC. Keeping every image in the standard system backgrounds hierarchy
# makes the same collection available to each desktop's wallpaper picker.
COPY wallpapers/ /usr/share/backgrounds/bootsy-linux/

# ============================== Session entries ==============================
#
# Explicit wayland-sessions entries for all three, rather than trusting each
# RPM's own file naming/labelling to stay stable across Fedora releases, so
# the graphical greeter always offers these stable names and commands.
RUN mkdir -p /usr/share/wayland-sessions

COPY <<-'EOF' /usr/share/wayland-sessions/niri.desktop
[Desktop Entry]
Name=Niri (DankMaterialShell)
Comment=A scrollable-tiling Wayland compositor
Exec=niri-session
Type=Application
EOF

COPY <<-'EOF' /usr/share/wayland-sessions/sway.desktop
[Desktop Entry]
Name=Sway
Comment=An i3-compatible tiling Wayland compositor
Exec=sway
Type=Application
EOF

COPY <<-'EOF' /usr/share/wayland-sessions/cosmic.desktop
[Desktop Entry]
Name=COSMIC
Comment=System76's Rust/Wayland desktop environment
Exec=cosmic-session
Type=Application
EOF

# ============================== Per-DE wiring ==============================

# niri: build a chezmoi source from niri's own shipped default (stays in sync
# with Fedora's package), then apply it for each user before their first
# graphical session. The user-level config is important: it gives every
# account a visible, editable baseline while the optional local.kdl include
# provides a stable place for overrides across image updates.
RUN mkdir -p /usr/share/bootsy/dotfiles/dot_config/niri \
    && printf '// Managed by Bootsy; image updates replace this file.\n// Put personal overrides in ~/.config/niri/local.kdl.\n\n' \
    > /usr/share/bootsy/dotfiles/dot_config/niri/config.kdl \
    && sed -e '/This line starts waybar/d' \
    -e '/^spawn-at-startup "waybar"$/d' \
    -e 's/Mod+D hotkey-overlay-title="Run an Application: fuzzel" { spawn "fuzzel"; }/Mod+D hotkey-overlay-title="Run an Application: DMS Spotlight" { spawn "dms" "ipc" "call" "spotlight" "toggle"; }/' \
    /usr/share/doc/niri/default-config.kdl >> /usr/share/bootsy/dotfiles/dot_config/niri/config.kdl \
    && printf '\nspawn-at-startup "dms" "run" "--session"\nspawn-at-startup "swaybg" "-i" "/usr/share/backgrounds/bootsy-linux/bootsy-zircon-flow.webp" "-m" "fill"\ninclude optional=true "local.kdl"\n' \
    >> /usr/share/bootsy/dotfiles/dot_config/niri/config.kdl
COPY niri/systemd/ /usr/lib/systemd/user/
RUN systemctl --global enable bootsy-dotfiles-init.service bootsy-dotfiles-update.timer

# sway: sway-config-fedora layers /etc/sway/config.d over its vendor snippets.
# Keep the wallpaper override and shadow its 90-bar.conf with DMS, which is
# launched by Sway so it inherits SWAYSOCK and can control workspaces/session
# actions. Waybar stays installed as an available fallback, but is not started.
COPY <<-'EOF' /etc/sway/config.d/40-wallpaper.conf
output * bg /usr/share/backgrounds/bootsy-linux/bootsy-zircon-flow.webp fill
EOF

# Replace Sway's title bars and bright-blue focus decoration with a restrained
# one-pixel neutral border that still makes keyboard focus visible.
COPY <<-'EOF' /etc/sway/config.d/45-appearance.conf
default_border pixel 1
default_floating_border pixel 1
hide_edge_borders smart
client.focused          #737985 #252830 #f3f4f6 #737985 #737985
client.focused_inactive #414650 #252830 #c7c9ce #414650 #414650
client.unfocused        #343840 #252830 #a9adb5 #343840 #343840
client.urgent           #bf616a #3b2529 #ffffff #bf616a #bf616a
EOF

# Fedora's stock Mod+D launches Fuzzel. Keep the familiar shortcut but hand it
# to DMS Spotlight so the launcher follows the active DMS theme.
COPY <<-'EOF' /etc/sway/config.d/60-bindings-dms.conf
unbindsym $mod+d
bindsym $mod+d exec dms ipc call spotlight toggle
EOF

COPY <<-'EOF' /etc/sway/config.d/90-bar.conf
exec dms run --session
EOF

# cosmic: cosmic-config (the RON-based settings store every COSMIC
# component uses) layers ~/.config/cosmic (highest) > /etc/xdg/cosmic
# (admin override) > /usr/share/cosmic (vendor default, RPM-owned) — write
# an /etc/xdg/cosmic override to point at Fedora's other official wallpaper
# set instead of editing the package-owned vendor file.
RUN mkdir -p /etc/xdg/cosmic/com.system76.CosmicBackground/v1
COPY <<-'EOF' /etc/xdg/cosmic/com.system76.CosmicBackground/v1/all
(
    output: "all",
    source: Path("/usr/share/backgrounds/bootsy-linux/bootsy-zircon-flow.webp"),
    filter_by_theme: true,
    rotation_frequency: 3600,
    filter_method: Lanczos,
    scaling_mode: Zoom,
    sampling_method: Alphanumeric,
)
EOF

# ============================== Login / session switching ==============================
#
# COSMIC Greeter runs a second COSMIC compositor for the login screen. On some
# otherwise-supported Intel systems it fails to acquire DRM master and exits
# with "Backend initialized without output". gtkgreet supplies a real GTK
# graphical login inside a dedicated minimal Sway compositor. XWayland is
# explicitly disabled in the greeter, and the compositor exits as soon as
# greetd starts the selected Niri, Sway, or COSMIC session.
COPY <<-'EOF' /etc/greetd/config.toml
[terminal]
vt = 1

[default_session]
command = "sway --config /etc/greetd/sway-config"
user = "greetd"
EOF

COPY <<-'EOF' /etc/greetd/sway-config
xwayland disable
output * bg /usr/share/backgrounds/bootsy-linux/bootsy-zircon-flow.webp fill
exec "gtkgreet -l -s /etc/greetd/gtkgreet.css; swaymsg exit"
EOF

COPY <<-'EOF' /etc/greetd/environments
niri-session
sway
cosmic-session
EOF

COPY <<-'EOF' /etc/greetd/gtkgreet.css
window {
    background-color: transparent;
    color: #f3f4f6;
    font-family: "Noto Sans";
    font-size: 16px;
}

box#body {
    background-color: rgba(24, 27, 34, 0.90);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 18px;
    padding: 42px;
}

entry, button, combobox {
    border-radius: 9px;
    padding: 8px;
}
EOF

RUN systemctl disable cosmic-greeter.service \
    && systemctl enable --force greetd.service

# ============================== Developer experience (bluefin-dx-inspired) ==============================
#
# Ported from Bluefin DX's own documented component list, not a full 1:1
# clone (skips Incus, JetBrains Toolbox, GPU compute libs, and kernel
# tracing tools — not asked for, easy to add later following this same
# pattern): Homebrew for CLI tools, Docker for devcontainer workflows,
# VS Code as the default editor, mise for per-project toolchains, Ptyxis
# as a distrobox-integrated terminal alongside alacritty, and Flatpak for
# graphical apps.

# Docker Engine: Fedora's own repos don't ship docker-ce (Fedora pushes
# podman instead), so this is the one deliberate departure from the
# Fedora-only-no-third-party-repo rule the base/server images follow —
# Docker's official repo is about as first-party as a third-party repo
# gets. The config-manager subcommand isn't in dnf5 itself, it needs the
# dnf5-plugins package first; syntax (`addrepo --from-repofile=`) also
# differs from dnf4's `--add-repo`.
RUN dnf -y install dnf5-plugins \
    && dnf5 config-manager addrepo --from-repofile=https://download.docker.com/linux/fedora/docker-ce.repo \
    && dnf -y install \
    docker-ce \
    docker-ce-cli \
    containerd.io \
    docker-buildx-plugin \
    docker-compose-plugin \
    && dnf clean all \
    && systemctl enable docker.service
# Add your login user to the `docker` group after first boot (no user
# account exists yet at build time): sudo usermod -aG docker $USER

# Homebrew: bakes in via ublue-os/brew's own documented pattern rather than
# running the installer at build time (Homebrew refuses to run as root,
# which is what a Containerfile RUN step is). This COPY --from lands the
# packed Homebrew tree plus a `brew-setup.service` that extracts it to
# /var/home/linuxbrew/.linuxbrew and fixes ownership on first boot, when a
# real non-root user context exists.
COPY --from=ghcr.io/ublue-os/brew:latest /system_files /
RUN systemctl enable brew-setup.service

# VS Code: Microsoft's official repo, the standard documented install path.
RUN rpm --import https://packages.microsoft.com/keys/microsoft.asc
COPY <<-'EOF' /etc/yum.repos.d/vscode.repo
[code]
name=Visual Studio Code
baseurl=https://packages.microsoft.com/yumrepos/vscode
enabled=1
gpgcheck=1
gpgkey=https://packages.microsoft.com/keys/microsoft.asc
EOF
RUN dnf -y install code && dnf clean all

# mise: not packaged by Fedora, installed via its own official script
# straight to /usr/local/bin (MISE_INSTALL_PATH overrides its normal
# per-user ~/.local/bin default, appropriate for a system image).
RUN curl -fsSL https://mise.run | MISE_INSTALL_PATH=/usr/local/bin/mise sh

# Ptyxis (distrobox-integrated terminal) and Just (task runner): plain
# Fedora 44 packages, no extra repo needed.
RUN dnf -y install ptyxis just && dnf clean all

# Flatpak + Flathub, for graphical apps outside the RPM/Homebrew tiers. Zen's
# own Linux documentation recommends its Flathub build; install it system-wide
# so every login sees the browser and its desktop entry.
RUN dnf -y install flatpak \
    && dnf clean all \
    && flatpak remote-add --system --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo \
    && flatpak install --system --noninteractive flathub \
        app.zen_browser.zen \
        com.github.tchx84.Flatseal

COPY <<-'EOF' /etc/xdg/mimeapps.list
[Default Applications]
text/html=app.zen_browser.zen.desktop
application/xhtml+xml=app.zen_browser.zen.desktop
x-scheme-handler/http=app.zen_browser.zen.desktop
x-scheme-handler/https=app.zen_browser.zen.desktop
inode/directory=org.gnome.Nautilus.desktop
application/pdf=org.gnome.Evince.desktop
image/jpeg=org.gnome.Loupe.desktop
image/png=org.gnome.Loupe.desktop
text/plain=org.gnome.TextEditor.desktop
EOF

# ============================== Boot target ==============================
#
# Unlike bootsy-server, bootsy-desktop boots straight to the greeter —
# without this the host stays on base's console default and the greeter never
# runs, leaving a bare tty.
RUN systemctl set-default graphical.target
