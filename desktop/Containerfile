ARG BASE_IMAGE=ghcr.io/eelcoh/bootsy-linux/base:latest
FROM ${BASE_IMAGE}

ARG BOOTSY_VERSION=development
ARG VCS_REF=unknown

RUN printf 'FLAVOR=desktop\nVERSION=%s\nVCS_REF=%s\n' "$BOOTSY_VERSION" "$VCS_REF" \
        > /usr/lib/bootsy-release

# bootsy-desktop: Niri+DankMaterialShell and COSMIC installed
# side by side, switchable at the graphical login screen rather
# than two separate images the way kubevirt-host-bootc-image did it.
# Plus a bluefin-dx-inspired developer
# experience layer (Homebrew, Docker, VS Code, mise, Ptyxis, Flatpak).

# ============================== Desktops ==============================
#
# Both DEs' packages plus their shared portal/audio/font stack, in one
# transaction. Package names/versions confirmed directly against Fedora 44
# repos (`dnf5 repoquery`) while building this image, no COPRs.
#
# - niri + DankMaterialShell: scrollable-tiling
#   compositor + DMS's Quickshell-based bar/launcher/lock/notifications).
# - cosmic-desktop (comps group, pulls in the compositor/panel/apps) +
#   xdg-desktop-portal-cosmic: System76's COSMIC. cosmic-greeter isn't in
#   the group's own mandatory/default package list, but cosmic-session
#   (which is) hard-Requires it as of Fedora 44's packaging (confirmed:
#   `dnf5 repoquery --whatrequires cosmic-greeter` lists every cosmic-session
#   build), so it ends up installed regardless of not being asked for. It's
#   used as the graphical display manager in the login section below.
# - alacritty: terminal for niri (matches its default Mod+T keybind);
#   COSMIC uses its own cosmic-term from the group.
# - firefox: Fedora's native package, installed alongside Zen as a
#   non-Flatpak fallback browser. Zen (below, via Flatpak) is the default.
# - bluez: explicit Bluetooth stack rather than relying on incidental desktop
#   group dependencies; DMS and COSMIC provide the pairing UI.
# - xdg-desktop-portal(-gtk/-gnome/-wlr/-cosmic), gnome-keyring, polkit-kde,
#   pipewire stack, Noto fonts: shared plumbing every session needs.
RUN dnf -y install \
    niri \
    DankMaterialShell \
    xdg-desktop-portal-cosmic \
    alacritty \
    bluez \
    xdg-desktop-portal \
    xdg-desktop-portal-gtk \
    xdg-desktop-portal-gnome \
    xdg-desktop-portal-wlr \
    gnome-keyring \
    polkit-kde \
    pipewire \
    pipewire-pulseaudio \
    pipewire-alsa \
    wireplumber \
    google-noto-sans-fonts \
    google-noto-emoji-fonts \
    swaybg \
    fedora-workstation-backgrounds \
    fwupd \
    bolt \
    iio-sensor-proxy \
    power-profiles-daemon \
    switcheroo-control \
    fprintd \
    cups \
    cups-pk-helper \
    system-config-printer \
    sane-airscan \
    libsane-airscan \
    simple-scan \
    ipp-usb \
    avahi \
    file-roller \
    loupe \
    evince \
    gnome-text-editor \
    nautilus \
    firefox \
    && dnf -y group install cosmic-desktop \
    && dnf clean all \
    && sed -i 's/^#AutoEnable=true$/AutoEnable=true/' /etc/bluetooth/main.conf \
    && systemctl enable bluetooth.service cups.service avahi-daemon.service

COPY desktop/docs/ /usr/share/doc/bootsy/desktop/

# Original Bootsy wallpaper collection, shared by Niri/DMS and COSMIC.
# Keeping every image in the standard system backgrounds hierarchy
# makes the same collection available to each desktop's wallpaper picker.
COPY wallpapers/ /usr/share/backgrounds/bootsy-linux/

# ============================== Session entries ==============================
#
# Explicit wayland-sessions entries for both, rather than trusting each
# RPM's own file naming/labelling to stay stable across Fedora releases, so
# the graphical greeter always offers these stable names and commands.
RUN mkdir -p /usr/share/wayland-sessions

COPY <<-'EOF' /usr/share/wayland-sessions/niri.desktop
[Desktop Entry]
Name=Niri (DankMaterialShell)
Comment=A scrollable-tiling Wayland compositor
Exec=niri-session
Type=Application
EOF

COPY <<-'EOF' /usr/share/wayland-sessions/cosmic.desktop
[Desktop Entry]
Name=COSMIC
Comment=System76's Rust/Wayland desktop environment
Exec=cosmic-session
Type=Application
EOF

# ============================== Per-DE wiring ==============================

# niri: build a chezmoi source from niri's own shipped default (stays in sync
# with Fedora's package), then apply it for each user before their first
# graphical session. The user-level config is important: it gives every
# account a visible, editable baseline while the optional local.kdl include
# provides a stable place for overrides across image updates.
#
# Niri's stock default.kdl ships its focus-ring on by default with
# active-color "#7fc8ff" (light blue); recolor it to a restrained neutral
# gray-blue instead. Also enable prefer-no-csd and a window-rule with
# geometry-corner-radius +
# clip-to-geometry (both off/commented out by default): without them niri's
# focus-ring draws around the client's full rectangular surface even when the
# client rounds its own corners via CSD, producing a border that visibly
# doesn't follow the window shape. Shadows are off by default too; turn them
# on, keeping niri's own stock softness/spread/offset/color values.
RUN mkdir -p /usr/share/bootsy/dotfiles/dot_config/niri \
    && printf '// Managed by Bootsy; image updates replace this file.\n// Put personal overrides in ~/.config/niri/local.kdl.\n\n' \
    > /usr/share/bootsy/dotfiles/dot_config/niri/config.kdl \
    && sed -e '/This line starts waybar/d' \
    -e '/^spawn-at-startup "waybar"$/d' \
    -e 's/Mod+D hotkey-overlay-title="Run an Application: fuzzel" { spawn "fuzzel"; }/Mod+D hotkey-overlay-title="Run an Application: DMS Spotlight" { spawn "dms" "ipc" "call" "spotlight" "toggle"; }/' \
    -e 's/active-color "#7fc8ff"/active-color "#737985"/' \
    -e 's/^        \/\/ on$/        on/' \
    -e 's/^\/\/ prefer-no-csd$/prefer-no-csd/' \
    /usr/share/doc/niri/default-config.kdl >> /usr/share/bootsy/dotfiles/dot_config/niri/config.kdl \
    && printf '\nwindow-rule {\n    geometry-corner-radius 6\n    clip-to-geometry true\n}\n\n// Overridden by DMS'"'"'s own matugen-generated colors once dynamic\n// theming runs (see the DankMaterialShell/settings.json seed below); this\n// include is a no-op until that file exists.\ninclude optional=true "dms/colors.kdl"\n\nspawn-at-startup "dms" "run" "--session"\nspawn-at-startup "swaybg" "-i" "/usr/share/backgrounds/bootsy-linux/bootsy-zircon-flow.webp" "-m" "fill"\ninclude optional=true "local.kdl"\n' \
    >> /usr/share/bootsy/dotfiles/dot_config/niri/config.kdl

# DMS renders its own background layer per monitor (Modules/WallpaperBackground.qml,
# WlrLayer.Background) from ~/.local/state/DankMaterialShell/session.json, entirely
# separate from the swaybg process above. That file starts out with no
# wallpaperPath set, so on first login DMS's own background layer is blank/black
# until the user picks a wallpaper in its settings — which briefly hides the
# correct swaybg image underneath and, once DMS finishes its (slow) Quickshell
# startup, replaces it with nothing until manually configured. Seed it with
# Bootsy's default wallpaper so DMS agrees with swaybg from the start. Uses
# chezmoi's create_ prefix (write once, never touch again) rather than the
# always-reapplied config.kdl above, since this file is DMS's own live state —
# clobbering it daily would reset the user's actual wallpaper/theme choices.
RUN mkdir -p '/usr/share/bootsy/dotfiles/dot_local/state/DankMaterialShell' \
    && printf '{\n  "wallpaperPath": "/usr/share/backgrounds/bootsy-linux/bootsy-zircon-flow.webp"\n}\n' \
    > '/usr/share/bootsy/dotfiles/dot_local/state/DankMaterialShell/create_session.json'

# DMS's own default theme is a static preset ("purple"), not wallpaper-driven.
# matugen (a hard dependency of the DankMaterialShell RPM, already installed)
# plus DMS's bundled per-app templates under /usr/share/quickshell/dms/matugen
# do the actual color generation once theming is switched to "dynamic" — every
# per-app template toggle (matugenTemplateNiri, matugenTemplateGtk, etc.)
# already defaults to on in DMS itself, so this one field is what's missing.
# ~/.config/DankMaterialShell/settings.json is DMS's own live settings store
# (same create_-once reasoning as session.json above: never reapply this one).
RUN mkdir -p '/usr/share/bootsy/dotfiles/dot_config/DankMaterialShell' \
    && printf '{\n  "currentThemeName": "dynamic"\n}\n' \
    > '/usr/share/bootsy/dotfiles/dot_config/DankMaterialShell/create_settings.json'

# DMS's GTK/alacritty matugen templates write generated colors to
# dank-colors.css/dank-theme.toml, but neither GTK nor alacritty loads those
# filenames on their own — DMS never touches gtk.css or alacritty.toml
# itself (confirmed from its matugen configs' output_path entries). COSMIC
# has its own theming system, so this is niri-specific; it lives alongside
# the niri/DMS chezmoi source above rather than in a separate section.
# gtk.css is pure plumbing to make dank-colors.css take effect, so it's
# always-managed like config.kdl;
# alacritty.toml is a user-facing config file, so it's create_-seeded like
# session.json — free to edit afterward, including its own import list.
RUN mkdir -p '/usr/share/bootsy/dotfiles/dot_config/gtk-3.0' \
        '/usr/share/bootsy/dotfiles/dot_config/gtk-4.0' \
        '/usr/share/bootsy/dotfiles/dot_config/alacritty' \
    && printf '@import url("dank-colors.css");\n' \
        > '/usr/share/bootsy/dotfiles/dot_config/gtk-3.0/gtk.css' \
    && printf '@import url("dank-colors.css");\n' \
        > '/usr/share/bootsy/dotfiles/dot_config/gtk-4.0/gtk.css' \
    && printf '[general]\nimport = ["~/.config/alacritty/dank-theme.toml"]\n' \
        > '/usr/share/bootsy/dotfiles/dot_config/alacritty/create_alacritty.toml'

COPY niri/systemd/ /usr/lib/systemd/user/
RUN systemctl --global enable bootsy-dotfiles-init.service bootsy-dotfiles-update.timer

# cosmic: cosmic-config (the RON-based settings store every COSMIC
# component uses) layers ~/.config/cosmic (highest) > /etc/xdg/cosmic
# (admin override) > /usr/share/cosmic (vendor default, RPM-owned) — write
# an /etc/xdg/cosmic override to point at Fedora's other official wallpaper
# set instead of editing the package-owned vendor file.
RUN mkdir -p /etc/xdg/cosmic/com.system76.CosmicBackground/v1
COPY <<-'EOF' /etc/xdg/cosmic/com.system76.CosmicBackground/v1/all
(
    output: "all",
    source: Path("/usr/share/backgrounds/bootsy-linux/bootsy-zircon-flow.webp"),
    filter_by_theme: true,
    rotation_frequency: 3600,
    filter_method: Lanczos,
    scaling_mode: Zoom,
    sampling_method: Alphanumeric,
)
EOF

# ============================== Login / session switching ==============================
#
# cosmic-greeter is a graphical display manager and reads the standard
# wayland-sessions entries above, giving the login screen a proper chooser
# for Niri and COSMIC.  cosmic-session already requires the greeter,
# so no additional login stack or hand-maintained greetd configuration is
# necessary. It also remembers the last user/session, which the graphical
# alternatives available from Fedora's repos (gtkgreet, tuigreet) don't do
# out of the box, and regreet isn't packaged for Fedora. cosmic-greeter has
# been seen to fail to acquire DRM master once ("Backend initialized without
# output"); its own shipped unit already carries
# After=plymouth-quit-wait.service and Restart=always/RestartSec=1, so a
# transient race like that is expected to self-heal rather than needing a
# different greeter entirely.
RUN systemctl enable --force cosmic-greeter.service

# ============================== Developer experience (bluefin-dx-inspired) ==============================
#
# Ported from Bluefin DX's own documented component list, not a full 1:1
# clone (skips Incus, JetBrains Toolbox, GPU compute libs, and kernel
# tracing tools — not asked for, easy to add later following this same
# pattern): Homebrew for CLI tools, Docker for devcontainer workflows,
# VS Code as the default editor, mise for per-project toolchains, Ptyxis
# as a distrobox-integrated terminal alongside alacritty, and Flatpak for
# graphical apps.

# Docker Engine: Fedora's own repos don't ship docker-ce (Fedora pushes
# podman instead), so this is the one deliberate departure from the
# Fedora-only-no-third-party-repo rule the base/server images follow —
# Docker's official repo is about as first-party as a third-party repo
# gets. The config-manager subcommand isn't in dnf5 itself, it needs the
# dnf5-plugins package first; syntax (`addrepo --from-repofile=`) also
# differs from dnf4's `--add-repo`.
RUN dnf -y install dnf5-plugins \
    && dnf5 config-manager addrepo --from-repofile=https://download.docker.com/linux/fedora/docker-ce.repo \
    && dnf -y install \
    docker-ce \
    docker-ce-cli \
    containerd.io \
    docker-buildx-plugin \
    docker-compose-plugin \
    && dnf clean all \
    && systemctl enable docker.service
# Add your login user to the `docker` group after first boot (no user
# account exists yet at build time): sudo usermod -aG docker $USER

# Homebrew: bakes in via ublue-os/brew's own documented pattern rather than
# running the installer at build time (Homebrew refuses to run as root,
# which is what a Containerfile RUN step is). This COPY --from lands the
# packed Homebrew tree plus a `brew-setup.service` that extracts it to
# /var/home/linuxbrew/.linuxbrew and fixes ownership on first boot, when a
# real non-root user context exists.
COPY --from=ghcr.io/ublue-os/brew:latest /system_files /
RUN systemctl enable brew-setup.service

# VS Code: Microsoft's official repo, the standard documented install path.
RUN rpm --import https://packages.microsoft.com/keys/microsoft.asc
COPY <<-'EOF' /etc/yum.repos.d/vscode.repo
[code]
name=Visual Studio Code
baseurl=https://packages.microsoft.com/yumrepos/vscode
enabled=1
gpgcheck=1
gpgkey=https://packages.microsoft.com/keys/microsoft.asc
EOF
RUN dnf -y install code && dnf clean all

# DMS's VS Code integration ships as an actual extension (a theme JSON with
# "_watch": true per theme, which VS Code reloads live on disk changes) that
# DMS's matugen template writes into once installed — there's no config file
# to seed the way GTK/alacritty needed above, but the extension itself has to
# be installed per-user, so it gets the same one-time first-login service
# pattern already used for the chezmoi dotfiles init above.
COPY <<-'EOF' /usr/lib/systemd/user/vscode-dms-theme.service
[Unit]
Description=Install DMS's dynamic-theme VS Code extension
ConditionPathExists=!%h/.config/bootsy/vscode-dms-theme-installed

[Service]
Type=oneshot
ExecStart=/usr/bin/mkdir -p %h/.config/bootsy
ExecStart=/usr/bin/code --install-extension /usr/share/quickshell/dms/matugen/dms-theme.vsix --force
ExecStart=/usr/bin/touch %h/.config/bootsy/vscode-dms-theme-installed

[Install]
WantedBy=default.target
EOF
RUN systemctl --global enable vscode-dms-theme.service

# Select the extension's theme by default; create_-seeded like alacritty.toml
# above, since ~/.config/Code/User/settings.json is a real user settings file.
RUN mkdir -p '/usr/share/bootsy/dotfiles/dot_config/Code/User' \
    && printf '{\n  "workbench.colorTheme": "Dynamic Base16 DankShell"\n}\n' \
    > '/usr/share/bootsy/dotfiles/dot_config/Code/User/create_settings.json'

# mise: not packaged by Fedora, installed via its own official script
# straight to /usr/local/bin (MISE_INSTALL_PATH overrides its normal
# per-user ~/.local/bin default, appropriate for a system image).
RUN curl -fsSL https://mise.run | MISE_INSTALL_PATH=/usr/local/bin/mise sh

# Ptyxis (distrobox-integrated terminal) and Just (task runner): plain
# Fedora 44 packages, no extra repo needed.
RUN dnf -y install ptyxis just && dnf clean all

# Flatpak + Flathub, for graphical apps outside the RPM/Homebrew tiers. Zen's
# own Linux documentation recommends its Flathub build; install it system-wide
# so every login sees the browser and its desktop entry, and set it as the
# default browser ahead of the native Firefox package installed above.
# Flatseal manages per-app Flatpak permissions; Bazaar (the same Flathub app
# store Bluefin ships) gives a GUI for installing anything else from Flathub.
#
# The `flatpak` package itself installs to /usr and upgrades normally, but
# `flatpak remote-add --system`/`flatpak install --system` both write under
# /var/lib/flatpak. bootc only seeds a container image's /var content into a
# genuinely fresh deployment; on `bootc update` of an already-provisioned
# machine, /var is left alone, so content added there by a build-time RUN
# here would silently never appear on any system that isn't freshly
# installed. So, same as KubeVirt/Agent Substrate/PostgreSQL in
# server/Containerfile, the actual remote-add/install happens in a
# first-boot bootstrap service instead.
RUN dnf -y install flatpak && dnf clean all

COPY <<-'EOF' /usr/local/bin/bootstrap-flatpak.sh
#!/bin/bash
set -e

flatpak remote-add --system --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo
flatpak install --system --noninteractive flathub \
    app.zen_browser.zen \
    com.github.tchx84.Flatseal \
    io.github.kolunmi.Bazaar
EOF
RUN chmod +x /usr/local/bin/bootstrap-flatpak.sh

COPY <<-'EOF' /usr/lib/systemd/system/flatpak-bootstrap.service
[Unit]
Description=Install Bootsy's default Flatpak applications
After=network-online.target
Wants=network-online.target
ConditionPathExists=!/var/lib/flatpak/exports/share/applications/app.zen_browser.zen.desktop

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/bootstrap-flatpak.sh

[Install]
WantedBy=multi-user.target
EOF

RUN systemctl enable flatpak-bootstrap.service

# Flatpak exports each app's .desktop file under
# /var/lib/flatpak/exports/share, which is only picked up automatically by
# login shells sourcing /etc/profile.d/flatpak.sh. niri-session is execed
# directly by greetd with no shell in between, so DMS Spotlight
# (Mod+D) would otherwise never see Flatpak apps. pam_systemd (greetd's PAM
# stack includes system-auth, which loads it) imports /etc/environment.d
# into every session regardless of shell, so set it there instead.
COPY <<-'EOF' /etc/environment.d/10-flatpak.conf
XDG_DATA_DIRS=/var/lib/flatpak/exports/share:/usr/local/share/:/usr/share/
EOF

COPY <<-'EOF' /etc/xdg/mimeapps.list
[Default Applications]
text/html=app.zen_browser.zen.desktop
application/xhtml+xml=app.zen_browser.zen.desktop
x-scheme-handler/http=app.zen_browser.zen.desktop
x-scheme-handler/https=app.zen_browser.zen.desktop
inode/directory=org.gnome.Nautilus.desktop
application/pdf=org.gnome.Evince.desktop
image/jpeg=org.gnome.Loupe.desktop
image/png=org.gnome.Loupe.desktop
text/plain=org.gnome.TextEditor.desktop
EOF

# ============================== Boot target ==============================
#
# Unlike bootsy-server, bootsy-desktop boots straight to the greeter —
# without this the host stays on base's console default and the greeter never
# runs, leaving a bare tty.
RUN systemctl set-default graphical.target
