FROM quay.io/fedora/fedora-bootc:44

ARG BOOTSY_VERSION=development
ARG VCS_REF=unknown

# bootsy-linux's shared base for both bootsy-server and bootsy-desktop.
# Directly descended from https://github.com/eelcoh/kubevirt-host-bootc-image
# (see that repo's CLAUDE.md for the fuller rationale behind fedora-bootc as
# the base and each of the steps below) — condensed here since this repo
# only ever builds two flavors on top of it, not eight.

# 1. Boot headless (console) by default. Flavors that need a desktop up
# bring it up themselves (server: on demand; desktop: always, see its own
# Containerfile's last step).
RUN systemctl set-default multi-user.target

# 2. KVM/libvirt, available on every flavor for free — bootsy-server uses it
# directly (KubeVirt), bootsy-desktop gets it for running local VMs.
RUN dnf -y install \
    qemu-kvm \
    libvirt \
    virt-install \
    util-linux \
    iptables \
    iscsi-initiator-utils \
    && dnf clean all

# systemd-remount-fs.service fails every boot on this composefs-based root
# (`fsconfig() failed: overlay: No changes allowed in reconfigure` —
# upstream ostree/bootc issue, not specific to this image). It's a `static`
# unit with no [Install] section, so `disable` can't touch it; masking is
# the only way to stop it running.
RUN systemctl mask systemd-remount-fs.service \
    && systemctl enable sshd.service

# 3. Baseline interactive tooling for every flavor: zsh as the default
# shell, chezmoi for dotfiles, atuin/zoxide for shell ergonomics,
# distrobox for ad-hoc containers (its podman-or-docker dependency is
# already satisfied by fedora-bootc's own podman). zsh is made the default
# for root and for any account `useradd` creates afterwards; per-flavor
# service accounts (e.g. desktop's greeter user) set their own `-s` and are
# unaffected.
RUN dnf -y install \
    git \
    zsh \
    chezmoi \
    atuin \
    zoxide \
    htop \
    btop \
    distrobox \
    firewalld \
    chrony \
    sos \
    lsof \
    strace \
    tcpdump \
    ethtool \
    nvme-cli \
    smartmontools \
    && dnf clean all \
    && usermod --shell /usr/bin/zsh root \
    && useradd -D -s /usr/bin/zsh

# Shared appliance identity, atomic update staging, host diagnostics, and an
# SSH-only firewall baseline. bootc's native timer downloads/stages updates but
# never interrupts a running machine with an unsolicited reboot.
RUN printf 'FLAVOR=base\nVERSION=%s\nVCS_REF=%s\n' "$BOOTSY_VERSION" "$VCS_REF" \
        > /usr/lib/bootsy-release \
    && systemctl enable firewalld.service chronyd.service \
        bootc-fetch-apply-updates.timer
COPY <<-'EOF' /etc/firewalld/zones/public.xml
<?xml version="1.0" encoding="utf-8"?>
<zone>
  <short>Public</short>
  <description>Bootsy default: SSH plus DHCPv6 client traffic only</description>
  <service name="ssh"/>
  <service name="dhcpv6-client"/>
</zone>
EOF
COPY system/bin/bootsy-status /usr/local/bin/bootsy-status
COPY system/bin/bootsy-distrobox-prompt /usr/local/bin/bootsy-distrobox-prompt
COPY system/libexec/bootsy-disk-health /usr/local/libexec/bootsy-disk-health
COPY system/systemd/ /usr/lib/systemd/system/
COPY system/zsh/distrobox-prompt.zsh /usr/share/bootsy/zsh/distrobox-prompt.zsh
COPY docs/ /usr/share/doc/bootsy/
RUN chmod 0755 /usr/local/bin/bootsy-status \
        /usr/local/bin/bootsy-distrobox-prompt \
        /usr/local/libexec/bootsy-disk-health \
    && systemctl enable bootsy-disk-health.timer

# 5. Fastfetch banner on every interactive shell, using the Boxed logomark.
# The ASCII art is COPYed in from branding/ rather than inlined as a heredoc
# so it stays a single source of truth with the SVG/wordmark it's derived
# from. /etc/zshrc (unlike /etc/profile.d) is sourced for both login and
# non-login interactive shells, which is what terminal emulators actually
# spawn, so that's where the invocation goes rather than the profile.d
# pattern used for env vars elsewhere in this repo.
RUN dnf -y install fastfetch && dnf clean all
COPY branding/bootsy-boxed.txt /etc/fastfetch/bootsy-boxed.txt
COPY <<-'EOF' /etc/xdg/fastfetch/config.jsonc
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema/config.json",
    "logo": {
        "type": "file",
        "source": "/etc/fastfetch/bootsy-boxed.txt"
    },
    "modules": [
        "title",
        "separator",
        "os",
        "host",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "display",
        "de",
        "wm",
        "wmtheme",
        "theme",
        "icons",
        "font",
        "cursor",
        "terminal",
        "terminalfont",
        "cpu",
        "gpu",
        "memory",
        "swap",
        "disk",
        "localip",
        "battery",
        "poweradapter",
        "locale",
        "break",
        "colors"
    ]
}
EOF
RUN printf '\n# bootsy-linux: show the Boxed banner on every interactive shell.\nfastfetch\n' >> /etc/zshrc
